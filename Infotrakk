      --primary: #3498db;
      --accent: #2980b9;
    }body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  background: var(--bg-light);
  color: var(--text-light);
  transition: background 0.3s, color 0.3s;
}

body.dark-mode {
  background: var(--bg-dark);
  color: var(--text-dark);
}

header {
  background-color: #222;
  color: #fff;
  padding: 2rem 1rem;
  text-align: center;
  position: relative;
}

header h1 {
  margin: 0;
  font-size: 2.5rem;
}

header p {
  font-style: italic;
  margin-top: 0.5rem;
}

#darkModeToggle {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: 2px solid white;
  border-radius: 5px;
  color: white;
  padding: 5px 10px;
  cursor: pointer;
}

nav {
  background: #444;
  text-align: center;
}

nav a {
  color: white;
  text-decoration: none;
  padding: 1rem;
  display: inline-block;
}

nav a:hover {
  background: #666;
}

.section {
  padding: 3rem 1.5rem;
  max-width: 900px;
  margin: auto;
}

.section h2 {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.newsletter-form input[type="email"] {
  padding: 10px;
  width: 70%;
  max-width: 300px;
  border-radius: 4px;
  border: 1px solid #ccc;
  margin-right: 10px;
}

.newsletter-form button {
  padding: 10px 20px;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

.newsletter-form button:hover {
  background: var(--accent);
}

.blog-post {
  background: #f1f1f1;
  padding: 1rem;
  border-left: 5px solid var(--primary);
  margin-bottom: 1rem;
  border-radius: 5px;
}

footer {
  text-align: center;
  padding: 2rem;
  background: #222;
  color: white;
  font-size: 0.9rem;
}

  </style>
</head>
